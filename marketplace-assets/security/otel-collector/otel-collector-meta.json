{
  "agent_key": "otel-collector",
  "agent_type": "tool-proxy",
  "version": "1.0.0",
  "display_name": "OpenTelemetry Collector",
  "description": "OpenTelemetry Collector의 헬스·파이프라인·메트릭 상태를 MCP Tool로 노출하는 어댑터 Agent입니다. 전용 화면이 없어 좌측 메뉴에는 표시되지 않으며, AI 어시스턴트를 통해 질의응답으로 사용합니다.",
  "description_en": "Adapter agent that exposes OpenTelemetry Collector health, pipeline, and metrics status as MCP tools. It has no dedicated screen and does not appear in the left menu — use it via Q&A through the AI Assistant.",
  "epic": "E15",
  "layer": "Cross",
  "capabilities": [
    {
      "verb": "query",
      "domain": "observability.otel-collector.health",
      "description": "Collector health_check extension 상태를 조회합니다",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object"
          },
          "status_code": {
            "type": "integer"
          }
        }
      },
      "qos": {
        "max_latency_ms": 5000,
        "supports_async": false,
        "supports_streaming": false
      }
    },
    {
      "verb": "query",
      "domain": "observability.otel-collector.pipeline",
      "description": "Collector 파이프라인(receiver/processor/exporter) 통계를 조회합니다",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {},
          "status_code": {
            "type": "integer"
          }
        }
      },
      "qos": {
        "max_latency_ms": 5000,
        "supports_async": false,
        "supports_streaming": false
      }
    },
    {
      "verb": "query",
      "domain": "observability.otel-collector.metrics",
      "description": "Collector 자체 Prometheus 메트릭 샘플을 조회합니다",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "status_code": {
            "type": "integer"
          }
        }
      },
      "qos": {
        "max_latency_ms": 10000,
        "supports_async": false,
        "supports_streaming": false
      }
    }
  ],
  "governance": {
    "data_classification": "internal",
    "human_approval_required": false,
    "audit_level": "standard"
  },
  "required_env": [],
  "optional_env": [
    "OTEL_HEALTH_URL",
    "OTEL_ZPAGES_URL",
    "OTEL_METRICS_URL"
  ],
  "default_env": {
    "OTEL_HEALTH_URL": "http://localhost:13133",
    "OTEL_ZPAGES_URL": "http://localhost:55679",
    "OTEL_METRICS_URL": "http://localhost:8889"
  },
  "min_platform_version": "2.0.0"
}
