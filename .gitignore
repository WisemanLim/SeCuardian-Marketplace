# ===== Harbor Registry (E03 T03-1/T03-2) =====
# prepare 가 생성하는 설정 파일 (harbor_install.sh 실행 결과)
deploy/docker/harbor-config/
# Harbor 런타임 데이터 볼륨 (compose named volumes 대체 경로)
deploy/docker/harbor-data/
# Cosign 서명 키 — 공개키(.pub)는 허용, 비밀키(.key)는 절대 금지
deploy/secrets/cosign/*.key
deploy/secrets/cosign/*.password
!deploy/secrets/cosign/*.pub

