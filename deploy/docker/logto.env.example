# Logto 환경변수 템플릿 — E01 T01-5
# 사용법: cp deploy/docker/logto.env.example deploy/docker/.env.logto
#         → .env.logto 값 채운 뒤 make logto-up
#
# 주의: .env.logto 는 .gitignore 적용 (절대 커밋 금지)
#       운영 환경은 Vault AppRole에서 동적 주입

# ── Logto 버전 ──────────────────────────────────────────────────────────────
LOGTO_VERSION=1.40.1

# ── PostgreSQL (Logto 전용) ──────────────────────────────────────────────────
LOGTO_DB_USER=logto
# 절대 금지: 실제 패스워드 커밋 금지
LOGTO_DB_PASSWORD=CHANGE_ME_16_CHARS_MIN
LOGTO_DB_DATABASE=logto

# ── 포트 (호스트 매핑) ───────────────────────────────────────────────────────
LOGTO_HTTP_PORT=3801
LOGTO_ADMIN_PORT=3802
