# Harbor 환경 변수 — deploy/docker/harbor.env.example
# .env.local 에 추가 (실제 값으로 변경)
# 🔴 실시크릿 커밋 금지

# Harbor URL (SeCuardian BE → Harbor API 연결)
HARBOR_URL=http://localhost:8083

# 초기 Admin 패스워드 (harbor_install.sh, harbor_setup.sh 사용)
HARBOR_ADMIN_PASSWORD=CHANGE_ME

# Harbor 프로젝트명 (harbor_setup.sh 생성)
HARBOR_PROJECT=secuardian

# Robot Account (harbor_setup.sh 실행 후 출력값 입력)
HARBOR_ROBOT_NAME=robot$secuardian-ci
HARBOR_ROBOT_SECRET=CHANGE_ME

# 인스톨러 설정 (harbor_install.sh 사용)
HARBOR_VERSION=v2.11.2
HARBOR_HTTP_PORT=8083
HARBOR_HTTPS_PORT=8443
HARBOR_DB_PASSWORD=CHANGE_ME
