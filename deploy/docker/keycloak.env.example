# Keycloak 환경변수 템플릿 — E01 T01-1
# 사용법: cp deploy/docker/keycloak.env.example deploy/docker/.env.keycloak
#         → .env.keycloak 값 채운 뒤 make keycloak-up
#
# 주의: .env.keycloak 은 .gitignore 적용 (절대 커밋 금지)
#       운영 환경은 Vault AppRole에서 동적 주입

# ── Keycloak Admin 계정 ──────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN16CHARS

# ── PostgreSQL (Keycloak 전용) ───────────────────────────────────────────────
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_DB_PASSWORD_MIN16CHARS
KC_DB_DATABASE=keycloak

# ── 호스트 설정 ──────────────────────────────────────────────────────────────
# 개발: localhost (변경 불필요)
# 운영: 실제 도메인 (예: keycloak.internal.company.com)
KC_HOSTNAME=localhost

# ── 포트 (호스트 매핑) ───────────────────────────────────────────────────────
# Admin Console / OIDC: http://localhost:8880/realms/master/.well-known/openid-configuration
KC_HTTP_PORT=8880
# Health / Metrics: http://localhost:9880/health/ready
KC_MGMT_PORT=9880

# ── 로그 레벨 ────────────────────────────────────────────────────────────────
# 개발: DEBUG | 운영: INFO
KC_LOG_LEVEL=INFO
