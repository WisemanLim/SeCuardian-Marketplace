# Vault 환경변수 템플릿 — E02 T02-1
# 사용법: cp deploy/docker/vault.env.example deploy/docker/.env.vault
#         → .env.vault 값 채운 뒤 make vault-up
#
# ⚠ .env.vault 는 .gitignore 적용 (절대 커밋 금지)
#   운영 Root Token은 초기화 후 즉시 revoke — AppRole 로 교체 (T02-2)

# ── Dev 모드 Root Token ──────────────────────────────────────────────────────
# 개발 전용 — 재시작 시 재사용되므로 변경 OK
VAULT_DEV_ROOT_TOKEN=dev-root-token-secuardian

# ── 포트 (호스트 매핑) ───────────────────────────────────────────────────────
# 기본 8201 (SeCuardian BE 포트 8200 과 충돌 방지)
VAULT_PORT=8201

# ── 로그 레벨 ────────────────────────────────────────────────────────────────
VAULT_LOG_LEVEL=info

# ── AppRole 인증 (E02 T02-2) ─────────────────────────────────────────────────
# make vault-setup 실행 후 출력된 값 입력 (Secret ID 24h TTL)
# 앱 연결(.env.local)에는 VAULT_ROLE_ID / VAULT_SECRET_ID 사용
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
