# Caddy 환경 설정 예시 — E04 T04-1
# 복사: cp deploy/docker/caddy.env.example deploy/docker/.env.caddy

# 포트 (호스트 → 컨테이너)
CADDY_HTTP_PORT=8280
CADDY_HTTPS_PORT=8443
CADDY_ADMIN_PORT=2019

# SeCuardian 업스트림 (host.docker.internal = 호스트 머신)
# Docker Compose 풀 스택: secuardian:8000
# 호스트 직접 실행: host.docker.internal:8200
CADDY_UPSTREAM=host.docker.internal:8200
