# CrowdSec 환경 설정 예시 — E04 T04-2
# 복사: cp deploy/docker/crowdsec.env.example deploy/docker/.env.crowdsec

# CrowdSec LAPI 포트 (호스트)
CROWDSEC_LAPI_PORT=8082

# 컨테이너 그룹 ID (로그 파일 읽기 권한)
GID=1000

# CrowdSec Central API 등록 토큰 (옵션 — CTI 위협 인텔리전스 공유)
# https://app.crowdsec.net 에서 발급, 빈 값이면 community CTI만 사용
CROWDSEC_ENROLL_KEY=

# SeCuardian이 LAPI 조회에 사용하는 Machine ID (make crowdsec-setup 으로 생성)
CROWDSEC_MACHINE_ID=secuardian-machine
CROWDSEC_MACHINE_PASSWORD=

# Bouncer API Key (make crowdsec-setup 으로 자동 발급 후 여기 기록)
# 🔴 커밋 금지
CROWDSEC_BOUNCER_KEY=
