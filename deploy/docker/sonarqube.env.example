# SonarQube 환경변수 (E08 T08-1)
# cp deploy/docker/sonarqube.env.example deploy/docker/.env.sonarqube
# 실제 운영 시 SONAR_DB_PASSWORD 를 강력한 비밀번호로 교체

# PostgreSQL (SonarQube 전용 DB)
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=changeme_strong_password

# SonarQube 포트 (기본 9000)
SONAR_PORT=9000
