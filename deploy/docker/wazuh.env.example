# Wazuh SIEM 환경변수 예시 — E06 T06-1
# 복사: cp deploy/docker/wazuh.env.example deploy/docker/.env.wazuh
# 🔴 실제 패스워드 커밋 금지 — .gitignore 에 .env.wazuh 포함됨

# ── 포트 (호스트) ─────────────────────────────────────────────────────────
WAZUH_AGENT_PORT=1514          # Wazuh 에이전트 syslog (UDP)
WAZUH_ENROLL_PORT=1515         # 에이전트 등록
WAZUH_API_PORT=55000           # Wazuh REST API
WAZUH_INDEXER_PORT=9200        # OpenSearch / Wazuh Indexer
WAZUH_DASHBOARD_PORT=5601      # Wazuh Dashboard

# ── Wazuh Indexer (OpenSearch) ───────────────────────────────────────────
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecureAdmin123!    # 🔴 변경 필수

# ── Wazuh API ────────────────────────────────────────────────────────────
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=Wazuh@Api2026!         # 🔴 변경 필수

# ── Wazuh Dashboard ──────────────────────────────────────────────────────
WAZUH_DASHBOARD_USER=kibanaserver
WAZUH_DASHBOARD_PASSWORD=DashBoard@2026!  # 🔴 변경 필수

# ── OpenSearch JVM 메모리 (최소 2GB 권장) ───────────────────────────────
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
