# Observability 스택 환경변수 예시 — E06 T06-2
# 복사: cp deploy/docker/observability.env.example deploy/docker/.env.observability
# 🔴 실제 패스워드 커밋 금지

# ── 포트 ───────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# ── Prometheus ────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=30d       # 메트릭 보존 기간

# ── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SecureGrafana2026!  # 🔴 변경 필수
