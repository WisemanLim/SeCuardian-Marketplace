{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.2.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "bargauge", "name": "Bar gauge", "version": ""},
    {"type": "panel", "id": "table", "name": "Table", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "SeCuardian 보안 KPI 대시보드 — MTTD/MTTR · CVE SLA · MFA 적용률 · SOAR 자동화율",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "핵심 KPI — MTTD · MTTR",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 120}, {"color": "red", "value": 480}]},
          "unit": "m",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "title": "MTTD (평균 탐지 시간)",
      "description": "목표: Y1 < 8h / Y2 < 2h / Y3 < 1h",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "secuardian_mttd_minutes", "legendFormat": "MTTD (분)", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 360}, {"color": "red", "value": 720}]},
          "unit": "m",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "title": "MTTR (평균 복구 시간)",
      "description": "목표: Y1 < 12h / Y2 < 6h / Y3 < 4h",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "secuardian_mttr_minutes", "legendFormat": "MTTR (분)", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 70}, {"color": "green", "value": 90}]},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "MFA 적용률",
      "description": "목표: Y1 ≥ 90% / Y2 = 100%",
      "type": "gauge",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "keycloak_users_with_mfa_percent", "legendFormat": "MFA %", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 20}, {"color": "green", "value": 60}]},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "SOAR 자동 대응률",
      "description": "목표: Y1 = 20% / Y2 = 60% / Y3 = 80%",
      "type": "gauge",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "secuardian_soar_auto_response_rate", "legendFormat": "Auto %", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "m", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "id": 5,
      "options": {"legend": {"calcs": ["mean", "min", "max"], "displayMode": "table", "placement": "right"}},
      "title": "MTTD / MTTR 트렌드 (30일)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "secuardian_mttd_minutes", "legendFormat": "MTTD", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "secuardian_mttr_minutes", "legendFormat": "MTTR", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "480", "legendFormat": "MTTD Y1 목표 (8h)", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "720", "legendFormat": "MTTR Y1 목표 (12h)", "refId": "D"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15},
      "id": 101,
      "title": "OSS 솔루션별 KPI",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 70}, {"color": "green", "value": 85}]},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "id": 6,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "title": "Critical CVE 패치 SLA 준수율",
      "description": "목표: Y1 70% / Y2 85% / Y3 95%",
      "type": "bargauge",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "vasca_cve_patched_within_sla_percent", "legendFormat": "패치 SLA %", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 50}, {"color": "green", "value": 80}]},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 16},
      "id": 7,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "title": "Falco 컨테이너 위협 커버리지",
      "description": "목표: MITRE Container Matrix ≥ 60%",
      "type": "bargauge",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "falco_mitre_container_coverage_percent", "legendFormat": "MITRE %", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 95}, {"color": "green", "value": 100}]},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 16},
      "id": 8,
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "title": "TruffleHog CI 통합률",
      "description": "목표: 100% (모든 리포 CI 적용)",
      "type": "bargauge",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "trufflehog_ci_integration_percent", "legendFormat": "CI %", "refId": "A"}]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "id": 102,
      "title": "실시간 보안 이벤트 요약",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "custom.width", "value": 80}]},
          {"matcher": {"id": "byName", "options": "Metric"}, "properties": [{"id": "custom.width", "value": 200}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "id": 9,
      "options": {"showHeader": true, "sortBy": []},
      "title": "보안 지표 현황표",
      "type": "table",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "secuardian_mttd_minutes", "legendFormat": "MTTD (분)", "refId": "A", "instant": true},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "secuardian_mttr_minutes", "legendFormat": "MTTR (분)", "refId": "B", "instant": true},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "crowdsec_active_decisions", "legendFormat": "CrowdSec 차단 IP", "refId": "C", "instant": true},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "vasca_cve_total{severity=\"CRITICAL\"}", "legendFormat": "VASCA CRITICAL CVE", "refId": "D", "instant": true},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "increase(falco_events_total{priority=\"Critical\"}[24h])", "legendFormat": "Falco Critical (24h)", "refId": "E", "instant": true}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "id": 10,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right"}},
      "title": "계층별 보안 이벤트 발생률 (5m avg)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "rate(keycloak_login_attempts_total{result=\"error\"}[5m])", "legendFormat": "L1 IAM 실패 로그인", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "rate(falco_events_total[5m])", "legendFormat": "L2 Falco 런타임", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "rate(crowdsec_alerts_total[5m])", "legendFormat": "L3 CrowdSec", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "rate(teler_threats_total[5m])", "legendFormat": "L4 teler HTTP IDS", "refId": "D"},
        {"datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "expr": "rate(secuardian_siem_alerts_total[5m])", "legendFormat": "L5 Wazuh SIEM", "refId": "E"}
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["secuardian", "kpi", "mttd", "mttr", "security"],
  "templating": {
    "list": [
      {"current": {}, "hide": 0, "includeAll": false, "name": "DS_PROMETHEUS", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource"},
      {"current": {}, "hide": 0, "includeAll": false, "name": "DS_LOKI", "options": [], "query": "loki", "refresh": 1, "type": "datasource"}
    ]
  },
  "time": {"from": "now-30d", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "SeCuardian Security KPI",
  "uid": "secuardian-kpi",
  "version": 1
}
