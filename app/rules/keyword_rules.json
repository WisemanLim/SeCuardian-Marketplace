{
  "version": "1.0",
  "description": "AI 어시스턴트 정적 키워드 룰셋 / AI Assistant static keyword ruleset",
  "rules": [
    {
      "id": "agent_list",
      "description": "에이전트 목록 조회 / List available agents",
      "keywords": [
        "에이전트 목록", "에이전트 리스트", "활성화된 에이전트", "사용 가능한 에이전트",
        "에이전트 알려", "에이전트 보여", "어떤 에이전트",
        "agent 목록", "agent 리스트", "agent 알려", "agent 보여", "제공하는 agent",
        "agent list", "list agents", "list agent", "available agents", "show agents", "what agents"
      ],
      "action": {
        "type": "api_call",
        "method": "GET",
        "path": "/api/agent-config/"
      },
      "format": {
        "type": "agent_list",
        "header_ko": "현재 활성화된 에이전트 목록입니다:",
        "header_en": "Currently active agents:"
      }
    },
    {
      "id": "disabled_feature",
      "description": "비활성화된 에이전트 기능 요청 / Request for disabled agent feature",
      "keywords": [],
      "action": {
        "type": "disabled_check"
      },
      "format": {
        "type": "disabled_message",
        "message_ko": "현재는 제공되지 않는 기능입니다.",
        "message_en": "This feature is not currently available."
      }
    }
  ]
}
