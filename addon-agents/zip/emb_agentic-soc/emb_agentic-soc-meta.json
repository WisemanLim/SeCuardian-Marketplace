{
  "agent_key": "emb_agentic-soc",
  "agent_type": "federation",
  "epic": "E20",
  "layer": "L5",
  "layer_name": "Detection",
  "name": "Agentic SOC",
  "description": "보안 에이전트들을 A2A로 오케스트레이션하고 인시던트 트리아지·플레이북을 실행하는 Agentic SOC 플랫폼입니다. 전용 화면이 없어 좌측 메뉴에는 표시되지 않으며, AI 어시스턴트를 통해 질의응답으로 사용합니다.",
  "description_en": "Federation platform that orchestrates security agents via A2A messaging, manages findings, and executes response playbooks. It has no dedicated screen and does not appear in the left menu — use it via Q&A through the AI Assistant.",
  "version": "1.0.0",
  "router_prefix": "/agentic-soc",
  "tags": [
    "agentic-soc"
  ],
  "capabilities": [
    "a2a",
    "findings",
    "playbooks"
  ],
  "env_vars": {
    "AGENTIC_SOC_ENABLED": {
      "default": "true",
      "description": "Enable or disable the Agentic SOC federation platform."
    },
    "AGENTIC_SOC_FINDINGS_MAX": {
      "default": "1000",
      "description": "Maximum number of findings to retain in memory (deque maxlen)."
    },
    "SECUARDIAN_BASE_URL": {
      "default": "http://localhost:8200",
      "description": "Base URL of the SeCuardian platform, advertised in the A2A agent card."
    }
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/.well-known/agent.json",
      "summary": "A2A agent card",
      "auth": false
    },
    {
      "method": "POST",
      "path": "/a2a",
      "summary": "Handle A2A message and route by intent",
      "auth": false
    },
    {
      "method": "GET",
      "path": "/status",
      "summary": "Platform status with finding counts and playbook count",
      "auth": true,
      "roles": [
        "any"
      ]
    },
    {
      "method": "GET",
      "path": "/findings",
      "summary": "List findings with optional filters",
      "auth": true,
      "roles": [
        "any"
      ],
      "query_params": [
        "limit",
        "severity",
        "source_agent",
        "acknowledged"
      ]
    },
    {
      "method": "POST",
      "path": "/findings",
      "summary": "Submit a finding from any agent",
      "auth": false
    },
    {
      "method": "PATCH",
      "path": "/findings/{finding_id}/acknowledge",
      "summary": "Mark a finding as acknowledged",
      "auth": true,
      "roles": [
        "any"
      ]
    },
    {
      "method": "GET",
      "path": "/playbooks",
      "summary": "List all playbooks",
      "auth": true,
      "roles": [
        "any"
      ]
    },
    {
      "method": "POST",
      "path": "/playbooks/{playbook_id}/execute",
      "summary": "Execute a playbook and log steps as findings",
      "auth": true,
      "roles": [
        "supervisor",
        "admin"
      ]
    },
    {
      "method": "GET",
      "path": "/config",
      "summary": "Return environment configuration",
      "auth": true,
      "roles": [
        "admin"
      ]
    }
  ],
  "builtin_playbooks": [
    {
      "playbook_id": "isolate-host",
      "trigger_intents": [
        "runtime_alert",
        "threat_intel"
      ],
      "steps": [
        "block-ip-crowdsec",
        "notify-wazuh",
        "create-incident"
      ]
    },
    {
      "playbook_id": "revoke-credentials",
      "trigger_intents": [
        "iam_query",
        "secrets_query"
      ],
      "steps": [
        "disable-keycloak-user",
        "revoke-vault-token",
        "audit-log"
      ]
    },
    {
      "playbook_id": "create-incident",
      "trigger_intents": [
        "siem_query",
        "compliance_report"
      ],
      "steps": [
        "open-shuffle-workflow",
        "notify-team",
        "collect-evidence"
      ]
    }
  ],
  "db_tables": false,
  "in_memory": {
    "findings_store": "deque(maxlen=AGENTIC_SOC_FINDINGS_MAX)",
    "playbook_store": "dict"
  }
}
