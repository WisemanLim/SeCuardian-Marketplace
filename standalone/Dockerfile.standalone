FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev || uv sync

# standalone_app 은 app.routers(a2a/mcp/auth) → app.db(마이그레이션, sql/) 전체를 사용한다
COPY app/ ./app/
COPY sql/ ./sql/
COPY standalone/ ./standalone/
COPY addon-agents/ ./addon-agents/

ARG AGENT_KEY=example
ARG AGENT_PORT=8001
ENV AGENT_STANDALONE=true \
    AGENT_KEY=${AGENT_KEY} \
    AGENT_PORT=${AGENT_PORT}

EXPOSE ${AGENT_PORT}
CMD ["sh", "-c", "uv run uvicorn standalone.standalone_app:app --host 0.0.0.0 --port ${AGENT_PORT:-8001}"]
